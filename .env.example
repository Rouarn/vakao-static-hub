# 服务器配置
PORT=9865
# JSON 请求体上限（不作用于 multipart 上传；普通文件上传无大小限制，APK 单包硬上限 500MB）
BODY_LIMIT=10mb
STATIC_PREFIX=/static
# 允许跨域调用后端 API 的来源（如 Vite dev server），多个用逗号分隔，留空则不开放跨域
CORS_ORIGIN=
# 是否挂载 Swagger 接口文档（/docs），生产环境建议设为 false
ENABLE_SWAGGER=true

# 认证配置
# AUTH_USER/AUTH_PASS 仅在首次启动且 users 表为空时用于初始化默认管理员
AUTH_USER=admin
AUTH_PASS=admin
JWT_SECRET=change-me-in-env
JWT_EXPIRES_IN=12h

# 数据库配置
# DB_PATH=storage/vakao.db
# 是否允许 TypeORM 按实体自动同步表结构：库文件不存在（首次部署）时无论本项为何都会自动建表；
# 已存在的库默认 false 以防实体变更意外 DROP/ALTER 表，生产环境保持 false
DB_SYNCHRONIZE=true

# 文件配置
# FILE_ROOT=storage
UPLOAD_MAX_COUNT=20
DEFAULT_CATEGORY=TemporaryFile

# 计划任务配置
# 5 minutes in ms
CACHE_REFRESH_INTERVAL_MS=300000

# 一言 API 配置
# 目标 API 地址 被转发到的 URL
HITOKOTO_API_URL=https://v1.hitokoto.cn

# APP 在线更新配置
# APK 下载链接的外部可访问基址；留空时从请求头（x-forwarded-* / Host）动态拼接
# APP_PUBLIC_BASE_URL=https://example.com
