{
  "collection": "@nestjs/schematics",
  "sourceRoot": "packages/backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "packages/backend/tsconfig.build.json",
    "assets": [
      {
        "include": "../public/**/*",
        "outDir": "packages/backend/dist/public",
        "watchAssets": true
      }
    ]
  }
}
